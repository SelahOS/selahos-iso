# SelahOS - Private files (never commit these)
selahbridge-license.py
selahbridge-keygen
*/selahbridge-license.py
*/selahbridge-keygen
*.secret

# License runtime keys (deployed at ISO build time — NEVER commit these)
**/.keydata
selahos-iso-v3/airootfs/etc/selahbridgepro/.keydata
selahos-iso-v3/airootfs/etc/selahbridge/.keydata

# SelahBridge legacy license dir
/airootfs/etc/selahbridge/

# Build artifacts
selahos-build/
selahos-iso-output/
*.iso
*.tar.gz
*.img
*.img.gz

# System
.DS_Store
__pycache__/
*.pyc
# Selahbridge scripts excluded from tracking (proprietary internals)
selahos-iso-v3/airootfs/usr/local/bin/selahbridge*
selahos-iso-v3/airootfs/usr/share/applications/selahbridge*

# Internal build + keygen tools — never commit
selahpro-keygen-deploy.sh
tools/selahpro-keygen-deploy.sh

# Compiled binary installer (source kept in tools/src/, gitignored)
install-selahbridgepro.sh

# Source backups created by tools/build-protected.sh
tools/src/

# Large kernel packages - stored locally only
selahos-iso-v3/local-repo/*.pkg.tar.zst
selahos-iso-v3/local-repo/*.pkg.tar.zst.sig

# 2026-09-04: bundled offline install repo, built by
# tools/build-offline-repo.sh — hundreds of packages, multi-GB, entirely
# regenerable from selahos-install-packages/*.txt. Never commit the
# package archives (or the repo-add DB/files metadata built from them);
# same rationale as local-repo/ above, just much larger.
selahos-iso-v3/airootfs/usr/local/share/selahos-offline-repo/

# Large VM files
*.qcow2
*.vmdk
*.vdi
*.iso
*.img

# Large VM files
*.qcow2
*.vmdk
*.vdi
*.iso
*.img

# Upstream Wine source checkout/tarballs used to build wine-gnutls-fix —
# multi-GB, not ours to track, trivially re-downloadable.
wine-src/

# selahos-website has its own git repo (github.com/SelahOS root), just
# happens to live nested under this checkout on disk — never track it here.
selahos-website/

# makepkg staging dirs (pkg/, src/) — regenerated by `makepkg`, not source.
# Keep PKGBUILD/.install/final .pkg.tar.zst, drop the build scratch.
packaging/*/pkg/
packaging/*/src/
