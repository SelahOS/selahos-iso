#!/usr/bin/env bash
# ============================================================
# SelahOS AppleseedCore Part 2 Installer
# Applies Apple-specific configurations post-installation
# Detects Apple hardware and applies SelahSeedCore drivers
# Copyright (C) 2026 Selah Technologies LLC
# ============================================================

set -eo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*"; }

# Check if running as root
if [[ $EUID -ne 0 ]]; then
    log_error "This script must be run as root"
    exit 1
fi

# Detect Apple hardware
detect_apple_hardware() {
    local manufacturer
    manufacturer=$(dmidecode -s system-manufacturer 2>/dev/null || echo "")

    if [[ "$manufacturer" =~ [Aa]pple ]]; then
        log_info "Apple hardware detected: $manufacturer"
        return 0
    else
        log_warn "Non-Apple hardware detected: $manufacturer"
        return 1
    fi
}

# Apply Apple-specific GRUB config
apply_apple_grub_config() {
    log_info "Applying Apple-specific GRUB configuration..."

    cat > /etc/default/grub << 'EOF'
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="SelahOS"
GRUB_DEFAULT=0
GRUB_CMDLINE_LINUX_DEFAULT="pcie_aspm=off acpi_osi=Darwin i915.enable_guc=2 loglevel=3 nomodeset mem_sleep_default=deep"
GRUB_CMDLINE_LINUX=""
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_TIMEOUT_STYLE=menu
GRUB_TERMINAL_INPUT=console
GRUB_GFXMODE=text
GRUB_GFXPAYLOAD_LINUX=text
GRUB_THEME=""
EOF

    grub-mkconfig -o /boot/grub/grub.cfg
    log_info "GRUB configuration updated"
}

# Apply SelahSeedCore configurations
apply_selahseedcore_config() {
    log_info "Applying SelahSeedCore hardware configurations..."

    # Create SelahSeedCore config directory
    mkdir -p /etc/selahos/seedcore

    # Apply each SelahSeedCore config file
    local config_dir="/usr/share/selahos/seedcore"
    if [[ -d "$config_dir" ]]; then
        for config in "$config_dir"/*.conf; do
            if [[ -f "$config" ]]; then
                local filename=$(basename "$config")
                log_info "Applying $filename"
                cp "$config" /etc/selahos/seedcore/
            fi
        done
    fi

    # Enable Apple-specific services
    systemctl enable bluetooth 2>/dev/null || log_warn "Failed to enable bluetooth"
    systemctl enable mbpfan 2>/dev/null || log_warn "mbpfan not available"

    log_info "SelahSeedCore configuration applied"
}

# Main installation flow
main() {
    echo "========================================"
    echo "SelahOS AppleseedCore Part 2 Installer"
    echo "========================================"
    echo

    if detect_apple_hardware; then
        log_info "Running Apple hardware configuration..."
        apply_apple_grub_config
        apply_selahseedcore_config
        echo
        log_info "AppleseedCore installation complete!"
        log_info "Please reboot for changes to take effect"
    else
        log_warn "Not running on Apple hardware - skipping AppleseedCore"
        log_info "Your system is configured for generic hardware"
        exit 0
    fi
}

main "$@"
