_MAC_PROFILES_PATH = '/usr/local/share/selahos/mac-profiles.json'

def _load_mac_profiles():
    try:
        with open(_MAC_PROFILES_PATH) as f:
            return json.load(f)
    except Exception:
        return {'models': {}, 'tiers': {}, 'fallback_apple': {}}

MAC_PROFILES = _load_mac_profiles()

def get_mac_profile(model_id):
    """Return profile dict for a model ID, or the fallback if unknown."""
    return MAC_PROFILES.get('models', {}).get(
        model_id, MAC_PROFILES.get('fallback_apple', {}))

def get_tier(tier_name):
    """Return tier dict by name."""
    return MAC_PROFILES.get('tiers', {}).get(tier_name, {})

