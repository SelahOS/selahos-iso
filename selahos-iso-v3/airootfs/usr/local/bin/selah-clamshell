#!/bin/bash
# selah-clamshell — SELAH-49: active clamshell-mode display handoff.
#
# systemd-logind owns suspend/resume for the lid switch (see
# /etc/systemd/logind.conf: HandleLidSwitch=suspend keeps the plain
# lid-close-to-suspend case working; HandleLidSwitchExternalPower=ignore
# means logind stays hands-off on AC power so this script can decide what
# "lid closed on AC" should mean). This script is invoked by acpid on every
# lid button event (see /etc/acpi/events/selah-lid) and only ever does two
# things: switch the display output when going into/out of clamshell mode,
# and trigger suspend itself for the one case logind was told to ignore but
# actually still needs to sleep (AC power, lid closed, no external display —
# never leave the machine running blind with the internal panel covered).
#
# acpid's own event-text format for lid events isn't reliable across kernel
# versions, so this reads lid state directly instead of parsing argv/%e.

set -u

INTERNAL_OUTPUT="eDP-1"
LID_STATE_FILE="$(command ls /proc/acpi/button/lid/*/state 2>/dev/null | head -1)"

lid_state() {
    [[ -n "$LID_STATE_FILE" && -r "$LID_STATE_FILE" ]] || { echo unknown; return; }
    awk '{print $NF}' "$LID_STATE_FILE"
}

on_ac_power() {
    local f
    for f in /sys/class/power_supply/*/online; do
        [[ -r "$f" ]] || continue
        [[ "$(cat "$f" 2>/dev/null)" == "1" ]] && return 0
    done
    return 1
}

# Find the active graphical (Plasma) session so kscreen-doctor can be run
# with that user's Wayland/D-Bus environment instead of root's.
find_session_user() {
    local sid uid user seat rest state type
    while read -r sid uid user seat rest; do
        [[ -n "$sid" ]] || continue
        state=$(loginctl show-session "$sid" -p State --value 2>/dev/null)
        type=$(loginctl show-session "$sid" -p Type --value 2>/dev/null)
        if [[ "$state" == "active" && ( "$type" == "wayland" || "$type" == "x11" ) ]]; then
            echo "${uid}:${user}"
            return 0
        fi
    done < <(loginctl list-sessions --no-legend 2>/dev/null)
    return 1
}

run_as_user_kscreen() {
    local uid="$1" user="$2"; shift 2
    runuser -u "$user" -- env \
        XDG_RUNTIME_DIR="/run/user/${uid}" \
        DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${uid}/bus" \
        WAYLAND_DISPLAY="wayland-0" \
        kscreen-doctor "$@"
}

sess="$(find_session_user)" || exit 0
[[ -n "$sess" ]] || exit 0
uid="${sess%%:*}"
user="${sess#*:}"

state="$(lid_state)"

case "$state" in
    closed)
        if on_ac_power; then
            external="$(run_as_user_kscreen "$uid" "$user" -j 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for o in d.get('outputs', []):
    if o.get('name') != '${INTERNAL_OUTPUT}' and o.get('connected'):
        print(o.get('name'))
        break
" 2>/dev/null)"
            if [[ -n "$external" ]]; then
                # AC power + external display present: hand off to it.
                run_as_user_kscreen "$uid" "$user" \
                    output."${INTERNAL_OUTPUT}".disable \
                    output."${external}".enable \
                    output."${external}".primary
            else
                # AC power, lid closed, nothing to hand off to. logind was
                # told to ignore this (HandleLidSwitchExternalPower=ignore),
                # so if we don't suspend here, nobody will.
                systemctl suspend
            fi
        fi
        # On battery, logind's HandleLidSwitch=suspend already handles this
        # independently — nothing for this script to do.
        ;;
    open)
        # Restore normal behavior regardless of how we got here.
        run_as_user_kscreen "$uid" "$user" output."${INTERNAL_OUTPUT}".enable
        ;;
esac
