#!/usr/bin/env bash
# ============================================================
# selah-rescue — SelahOS Boot Recovery Tool
#
# Run from a SelahOS USB stick when your installed system
# won't boot. Common causes:
#   - Mac NVRAM reset wiped EFI boot entry
#   - Bootloader files damaged
#   - Wrong kernel selected as default
#
# This tool:
#   1. Detects your installed SelahOS partition
#   2. Mounts it
#   3. chroots in
#   4. Checks and repairs the bootloader for this machine's boot mode
#      (UEFI or legacy BIOS) using selah-doctor -- EFI installs use the
#      --removable fallback, so a Mac NVRAM reset can't hide them
#   5. Regenerates initramfs
#
# Copyright (C) 2026 Selah Technologies LLC
# Licensed under GPL-3.0-or-later
# ============================================================

set -e

GOLD='\033[38;2;214;168;90m'
TEAL='\033[38;2;142;195;184m'
DANGER='\033[38;2;154;92;84m'
PARCH='\033[38;2;241;232;216m'
RESET='\033[0m'

if [ "$EUID" -ne 0 ]; then
    echo -e "${DANGER}selah-rescue must be run as root.${RESET}"
    echo "  sudo selah-rescue"
    exit 1
fi

echo -e "${GOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo -e "${GOLD}  SelahOS Rescue Tool${RESET}"
echo -e "${PARCH}  Recovering an installed SelahOS system${RESET}"
echo -e "${GOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
echo ""

# Find candidate root partitions
echo -e "${PARCH}→ Scanning for SelahOS installations...${RESET}"
echo ""

# List ext4 partitions
mapfile -t PARTITIONS < <(lsblk -ln -o NAME,FSTYPE,SIZE,MOUNTPOINT | awk '$2=="ext4" && $4=="" {print $1}')

if [ ${#PARTITIONS[@]} -eq 0 ]; then
    echo -e "${DANGER}✗ No unmounted ext4 partitions found.${RESET}"
    echo "  Your installed system may use a different filesystem,"
    echo "  or no installation exists on this machine."
    exit 1
fi

# Show options
echo "Found these candidate partitions:"
for i in "${!PARTITIONS[@]}"; do
    PART="${PARTITIONS[$i]}"
    SIZE=$(lsblk -ln -o SIZE "/dev/$PART" 2>/dev/null | head -1)
    echo "  [$((i+1))] /dev/$PART ($SIZE)"
done
echo ""

read -rp "Which partition is your SelahOS root? [1-${#PARTITIONS[@]}]: " CHOICE
ROOT_PART="${PARTITIONS[$((CHOICE-1))]}"

if [ -z "$ROOT_PART" ]; then
    echo -e "${DANGER}Invalid choice.${RESET}"
    exit 1
fi

echo ""
echo -e "${PARCH}→ Mounting /dev/$ROOT_PART...${RESET}"
mkdir -p /mnt/selahos-rescue
mount "/dev/$ROOT_PART" /mnt/selahos-rescue

# Verify it's a SelahOS install
if [ ! -f /mnt/selahos-rescue/etc/os-release ] || ! grep -q "selahos" /mnt/selahos-rescue/etc/os-release; then
    echo -e "${DANGER}✗ This doesn't appear to be a SelahOS partition.${RESET}"
    umount /mnt/selahos-rescue
    exit 1
fi

echo -e "${TEAL}  ✓ SelahOS installation detected${RESET}"

# Find the EFI partition. B-47 (2026-09-21): look on the SAME disk as the root
# partition you chose first -- the old "first vfat anywhere" could pick an
# unrelated partition (e.g. a Ventoy USB) -- and only fall back to that.
echo ""
echo -e "${PARCH}→ Looking for EFI partition...${RESET}"
ROOT_DISK=$(lsblk -no PKNAME "/dev/$ROOT_PART" 2>/dev/null | head -1)
EFI_PART=""
if [ -n "$ROOT_DISK" ]; then
    EFI_PART=$(lsblk -ln -o NAME,FSTYPE,PKNAME | awk -v d="$ROOT_DISK" '$2=="vfat" && $3==d {print $1; exit}')
fi
[ -n "$EFI_PART" ] || EFI_PART=$(lsblk -ln -o NAME,FSTYPE | awk '$2=="vfat" {print $1; exit}')

if [ -z "$EFI_PART" ]; then
    if [ -d /sys/firmware/efi ]; then
        echo -e "${DANGER}✗ No EFI partition found.${RESET}"
        umount /mnt/selahos-rescue
        exit 1
    fi
    echo -e "${PARCH}  No EFI partition found — fine on a legacy-BIOS machine, continuing.${RESET}"
else
    echo -e "${TEAL}  ✓ EFI partition: /dev/$EFI_PART${RESET}"
    # Current installs (selah-setup) keep the ESP at /boot/efi; the retired
    # installer mounted it at /boot. Use whichever this system expects.
    if [ -d /mnt/selahos-rescue/boot/efi ]; then
        ESP_MNT=/mnt/selahos-rescue/boot/efi
    else
        ESP_MNT=/mnt/selahos-rescue/boot
    fi
    mkdir -p "$ESP_MNT"
    mount "/dev/$EFI_PART" "$ESP_MNT"
fi

# Bootloader. B-47 (2026-09-21): this used to run its own EFI-only grub-install
# (with the old ESP-at-/boot layout), which did nothing for a BIOS boot and
# never checked the result. selah-doctor already knows both firmware modes and
# the current layout, and verifies the real artifact (EFI files, or MBR boot
# code + core.img), so delegate to it. It runs GRUB's install through
# arch-chroot, which sets up /dev /proc /sys /run itself.
echo ""
echo -e "${PARCH}→ Checking and repairing the bootloader (selah-doctor)...${RESET}"
if ! command -v selah-doctor >/dev/null 2>&1; then
    echo -e "${DANGER}✗ selah-doctor is missing from this USB — cannot repair the bootloader.${RESET}"
    umount -R /mnt/selahos-rescue 2>/dev/null || true
    exit 1
fi
DOCTOR_RC=0
selah-doctor --target /mnt/selahos-rescue --fix || DOCTOR_RC=$?

echo -e "${PARCH}→ Regenerating initramfs...${RESET}"
arch-chroot /mnt/selahos-rescue mkinitcpio -P || true

# Cleanup (-R also takes down the ESP mounted under /boot/efi or /boot)
echo ""
echo -e "${PARCH}→ Cleaning up...${RESET}"
umount -R /mnt/selahos-rescue 2>/dev/null || true

echo ""
echo -e "${GOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
if [ "$DOCTOR_RC" -eq 2 ]; then
    echo -e "${DANGER}  ✗ Some problems could not be repaired — see the selah-doctor output above.${RESET}"
    echo -e "${PARCH}  Do not rely on this system booting; ask for help at beta@selahos.io.${RESET}"
    echo -e "${GOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    exit 1
fi
echo -e "${TEAL}  ✓ Recovery complete${RESET}"
echo -e "${PARCH}  Remove the USB stick and reboot.${RESET}"
echo -e "${GOLD}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
