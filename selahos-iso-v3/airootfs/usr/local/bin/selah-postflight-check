#!/bin/bash
# selah-postflight-check.sh — v2
# SelahOS Postflight — Live System Health Check & Repair
#
# Usage:
#   sudo bash selah-postflight-check.sh          # diagnose only (safe, read-only)
#   sudo bash selah-postflight-check.sh --fix    # diagnose AND repair known issues
#
# Exit codes: 0 = all pass, 1 = warnings, 2 = failures

FIX_MODE=0
[[ "$1" == "--fix" ]] && FIX_MODE=1

PASS=0; WARN=0; FAIL=0; FIXED=0
pass() { echo "  [PASS] $1"; PASS=$((PASS+1)); }
warn() { echo "  [WARN] $1"; WARN=$((WARN+1)); }
fail() { echo "  [FAIL] $1"; FAIL=$((FAIL+1)); }
fixed(){ echo "  [FIXED] $1"; FIXED=$((FIXED+1)); }
info() { echo "  [INFO] $1"; }

echo "================================================================"
echo " SelahOS Postflight v2 — Live System Health Check"
echo " $(date)"
[[ $FIX_MODE -eq 1 ]] && echo " MODE: DIAGNOSE + REPAIR" || echo " MODE: diagnose only (use --fix to repair)"
echo "================================================================"

# ================================================================
echo ""
echo "-- 1. WiFi: WPA3/SAE compatibility (Broadcom) --"
# ================================================================
# Known issue: brcmfmac on older Broadcom chips (BCM4350 etc.) cannot
# reliably complete WPA3/SAE handshake. Symptom: endless
# associate -> "association took too long" -> ssid-not-found loop.

BRCM_CHIP=$(lspci 2>/dev/null | grep -i "network controller" | grep -i broadcom)
if [ -n "$BRCM_CHIP" ]; then
    info "Broadcom WiFi detected: $(echo "$BRCM_CHIP" | sed 's/.*: //')"

    SAE_CONNS=$(nmcli -t -f NAME connection show 2>/dev/null | while read -r c; do
        [ -z "$c" ] && continue
        KM=$(nmcli connection show "$c" 2>/dev/null | grep "wireless-security.key-mgmt:" | awk '{print $2}')
        [ "$KM" == "sae" ] && echo "$c"
    done)

    if [ -n "$SAE_CONNS" ]; then
        fail "WiFi profile(s) set to WPA3/SAE on a Broadcom chip known to fail with it:"
        echo "$SAE_CONNS" | sed 's/^/         /'
        echo "         Symptom: connects, times out, retries forever ('ssid-not-found')"
        if [ $FIX_MODE -eq 1 ]; then
            echo "$SAE_CONNS" | while read -r c; do
                if nmcli connection modify "$c" wifi-sec.key-mgmt wpa-psk 2>/dev/null; then
                    fixed "Set '$c' to WPA2 (wpa-psk)"
                else
                    fail "Could not modify '$c'"
                fi
            done
            info "Reconnect with: nmcli connection up \"<name>\""
        else
            info "Fix: sudo nmcli connection modify \"<name>\" wifi-sec.key-mgmt wpa-psk"
        fi
    else
        pass "No WPA3/SAE profiles on Broadcom hardware"
    fi

    # WiFi power save
    if [ ! -f /etc/NetworkManager/conf.d/wifi-powersave.conf ]; then
        warn "WiFi power saving not explicitly disabled (can cause intermittent drops)"
        if [ $FIX_MODE -eq 1 ]; then
            mkdir -p /etc/NetworkManager/conf.d
            printf '[connection]\nwifi.powersave = 2\n' > /etc/NetworkManager/conf.d/wifi-powersave.conf
            fixed "Disabled WiFi power saving (restart NetworkManager to apply)"
        fi
    else
        pass "WiFi power saving configuration present"
    fi

    # The config file above only takes effect on the next NM-managed
    # association; check the driver's actual live state so a config
    # written but not yet applied (no restart since) still shows up.
    if command -v iw &>/dev/null; then
        WIFI_IF=$(iw dev 2>/dev/null | awk '$1=="Interface"{print $2; exit}')
        if [ -n "$WIFI_IF" ]; then
            PS=$(iw dev "$WIFI_IF" get power_save 2>/dev/null | awk '{print $NF}')
            if [ "$PS" = "off" ]; then
                pass "Live WiFi power save is off on $WIFI_IF"
            elif [ "$PS" = "on" ]; then
                warn "Live WiFi power save is ON on $WIFI_IF (config may not be applied yet)"
                if [ $FIX_MODE -eq 1 ]; then
                    iw dev "$WIFI_IF" set power_save off 2>/dev/null \
                        && fixed "Set power_save off on $WIFI_IF" \
                        || fail "Could not set power_save on $WIFI_IF"
                else
                    info "Fix: sudo iw dev $WIFI_IF set power_save off (or restart NetworkManager)"
                fi
            else
                info "Could not read live power_save state for $WIFI_IF"
            fi
        else
            info "No active WiFi interface to check live power_save state"
        fi
    else
        warn "iw not installed — cannot verify live WiFi power-save state (fix: pacman -S iw)"
    fi
else
    info "No Broadcom WiFi detected — WPA3 check not applicable"
fi

# ================================================================
echo ""
echo "-- 2. Internet connectivity --"
# ================================================================
# NetworkManager's own connectivity checker forces a fresh probe rather
# than trusting cached state, which is what actually matters for "does
# the internet work right now" -- an interface can show "connected" while
# genuinely unable to reach anything (captive portal, DNS down, etc.).
if command -v nmcli &>/dev/null; then
    CONN_STATE=$(nmcli networking connectivity check 2>/dev/null)
    case "$CONN_STATE" in
        full)
            pass "NetworkManager reports full connectivity" ;;
        portal)
            fail "Behind a captive portal — internet not actually reachable yet" ;;
        limited)
            fail "Limited connectivity (local network reachable, internet is not)" ;;
        none)
            info "No connectivity at all — normal if no network is configured yet, otherwise check cabling/WiFi"
            ;;
        *)
            warn "Could not determine connectivity state (nmcli returned: ${CONN_STATE:-<empty>})" ;;
    esac
else
    warn "nmcli not available — cannot check connectivity state"
fi

# DNS resolution -- separate from raw reachability below, since a host
# can be reachable by IP with DNS still broken (wrong/unreachable
# resolver), which looks like "no internet" to every actual app.
if command -v getent &>/dev/null; then
    if getent hosts archlinux.org &>/dev/null; then
        pass "DNS resolution works"
    else
        fail "DNS resolution failed for archlinux.org — check /etc/resolv.conf / NetworkManager DNS settings"
    fi
else
    warn "getent not available — cannot check DNS resolution"
fi

# Actual reachability, not just link state. Short timeout so this never
# hangs the whole postflight run on a genuinely offline machine.
if command -v curl &>/dev/null; then
    if curl -fsS --max-time 5 -o /dev/null https://archlinux.org 2>/dev/null; then
        pass "Internet reachable (HTTPS to archlinux.org succeeded)"
    else
        fail "Could not reach the internet over HTTPS — pacman/AUR/repo.selahos.io will all fail"
    fi
else
    warn "curl not available — cannot verify real internet reachability"
fi

# ================================================================
echo ""
echo "-- 3. Sleep / suspend --"
# ================================================================
MASKED=""
for t in sleep.target suspend.target hibernate.target suspend-then-hibernate.target; do
    if systemctl is-enabled "$t" 2>&1 | grep -q masked; then
        MASKED="$MASKED $t"
    fi
done

if [ -n "$MASKED" ]; then
    fail "Sleep targets are MASKED — machine cannot suspend (drains battery, overheats in bag):$MASKED"
    if [ $FIX_MODE -eq 1 ]; then
        systemctl unmask $MASKED >/dev/null 2>&1 && fixed "Unmasked:$MASKED"
    else
        info "Fix: sudo systemctl unmask$MASKED"
    fi
else
    pass "Sleep targets not masked"
fi

if [ -f /sys/power/mem_sleep ]; then
    # 2026-09-06: "deep" is NOT universally correct — confirmed on a real
    # MacBook10,1 that deep (S3) suspend never resumes at all (hangs
    # forever), while s2idle at least resumes the kernel/network layer.
    # The right mode is per-hardware (see hardware-db.json's per-model
    # mem_sleep_default), so this check only confirms a mode is
    # explicitly selected — not which one.
    if grep -qE "\[(deep|s2idle)\]" /sys/power/mem_sleep; then
        pass "Sleep mode explicitly selected ($(cat /sys/power/mem_sleep))"
    else
        warn "No sleep mode explicitly selected: $(cat /sys/power/mem_sleep) — check hardware-db.json's mem_sleep_default for this model"
    fi
fi

for pkg in tlp thermald; do
    if pacman -Q "$pkg" &>/dev/null; then
        systemctl is-active --quiet "$pkg" && pass "$pkg active" || warn "$pkg installed but not active"
    else
        warn "$pkg not installed"
    fi
done

# ================================================================
echo ""
echo "-- 4. DKMS module health --"
# ================================================================
if ! command -v dkms &>/dev/null; then
    fail "DKMS is NOT INSTALLED — out-of-tree drivers (WiFi, audio, FaceTime cam) cannot build or survive kernel updates"
    if [ $FIX_MODE -eq 1 ]; then
        if pacman -S --noconfirm --needed dkms linux-zen-headers &>/dev/null; then
            fixed "Installed dkms + kernel headers (reboot recommended)"
        else
            fail "DKMS install failed — check network connection"
        fi
    else
        info "Fix: sudo pacman -S dkms linux-zen-headers"
    fi
else
    pass "DKMS installed"
    KVER=$(uname -r)
    for pkg in broadcom-wl-dkms snd-hda-macbookpro-dkms-git facetimehd-dkms; do
        if pacman -Q "$pkg" &>/dev/null; then
            MODNAME=$(echo "$pkg" | sed 's/-dkms.*//; s/snd-hda-macbookpro/snd-hda-macbookpro/')
            if dkms status 2>/dev/null | grep -q "$KVER"; then
                pass "$pkg present, DKMS has builds for $KVER"
            else
                fail "$pkg installed but NOT built for running kernel $KVER"
                if [ $FIX_MODE -eq 1 ]; then
                    dkms autoinstall -k "$KVER" &>/dev/null && fixed "Rebuilt DKMS modules for $KVER" || fail "DKMS rebuild failed (kernel headers missing?)"
                fi
            fi
        else
            warn "$pkg NOT installed"
            [[ $FIX_MODE -eq 1 ]] && { pacman -S --noconfirm --needed "$pkg" &>/dev/null && fixed "Installed $pkg" || warn "Could not install $pkg (may need AUR)"; }
        fi
    done
fi

# ================================================================
echo ""
echo "-- 5. Audio (CS8409 / Apple codecs) --"
# ================================================================
if command -v aplay &>/dev/null; then
    CARDS=$(aplay -l 2>/dev/null | grep "^card")
    if [ -z "$CARDS" ]; then
        fail "No audio playback devices detected"
        if pacman -Q snd-hda-macbookpro-dkms-git &>/dev/null; then
            info "snd-hda-macbookpro is installed — likely a DKMS build issue (see section 3)"
        else
            fail "snd-hda-macbookpro-dkms-git NOT installed — required for Apple CS8409 audio"
            [[ $FIX_MODE -eq 1 ]] && info "Install via AUR; not available in standard repos"
        fi
    else
        pass "Audio devices detected:"
        echo "$CARDS" | sed 's/^/         /'
    fi
    lsmod | grep -q snd_hda_macbookpro && pass "snd_hda_macbookpro module loaded" || warn "snd_hda_macbookpro module not loaded"
else
    warn "alsa-utils not installed — cannot verify audio (fix: pacman -S alsa-utils)"
fi

# General "does audio work at all" -- separate from the CS8409-specific
# checks above, since a non-Apple-codec machine has no CS8409 section to
# fail but can still have a dead PipeWire session. PipeWire/WirePlumber
# run in the logged-in user's session, not root's, so this has to reach
# into that session the same way selah-clamshell does (runuser with the
# right XDG_RUNTIME_DIR/DBUS_SESSION_BUS_ADDRESS) rather than just
# checking `systemctl` as root, which would only ever see the system bus.
AUDIO_USER=$(loginctl list-sessions --no-legend 2>/dev/null | awk '$3=="seat0"{print $2; exit}')
if [ -z "$AUDIO_USER" ]; then
    AUDIO_USER=$(who 2>/dev/null | awk '{print $1; exit}')
fi
if [ -n "$AUDIO_USER" ]; then
    AUDIO_UID=$(id -u "$AUDIO_USER" 2>/dev/null)
    RUNDIR="/run/user/$AUDIO_UID"
    if [ -n "$AUDIO_UID" ] && [ -d "$RUNDIR" ]; then
        PW_STATE=$(runuser -u "$AUDIO_USER" -- env XDG_RUNTIME_DIR="$RUNDIR" \
            systemctl --user is-active pipewire.service 2>/dev/null)
        if [ "$PW_STATE" = "active" ]; then
            pass "PipeWire is active in $AUDIO_USER's session"
        else
            fail "PipeWire is not active in $AUDIO_USER's session (state: ${PW_STATE:-unknown}) — no audio will play at all"
            if [ $FIX_MODE -eq 1 ]; then
                runuser -u "$AUDIO_USER" -- env XDG_RUNTIME_DIR="$RUNDIR" \
                    systemctl --user restart pipewire.service pipewire-pulse.service wireplumber.service &>/dev/null \
                    && fixed "Restarted PipeWire/WirePlumber for $AUDIO_USER" \
                    || fail "Could not restart PipeWire for $AUDIO_USER"
            else
                info "Fix: systemctl --user restart pipewire.service pipewire-pulse.service wireplumber.service (as $AUDIO_USER)"
            fi
        fi

        SINKS=$(runuser -u "$AUDIO_USER" -- env XDG_RUNTIME_DIR="$RUNDIR" \
            pactl list sinks short 2>/dev/null)
        if [ -n "$SINKS" ]; then
            pass "At least one audio output sink is registered"
        else
            fail "No audio output sinks registered — nothing to play sound through, even if PipeWire is running"
        fi
    else
        warn "Could not find a runtime dir for $AUDIO_USER (session not fully up?) — skipping PipeWire check"
    fi
else
    info "No logged-in graphical user found — skipping PipeWire/session audio check (normal at a bare TTY)"
fi

# ================================================================
echo ""
echo "-- 6. Disk health (SMART) --"
# ================================================================
if ! command -v smartctl &>/dev/null; then
    warn "smartmontools not installed — cannot check disk health"
    if [ $FIX_MODE -eq 1 ]; then
        pacman -S --noconfirm --needed smartmontools &>/dev/null \
            && fixed "Installed smartmontools" \
            || fail "Could not install smartmontools"
    else
        info "Fix: sudo pacman -S smartmontools"
    fi
else
    DISKS=$(lsblk -dno NAME,TYPE 2>/dev/null | awk '$2=="disk"{print $1}')
    if [ -z "$DISKS" ]; then
        info "No block devices found to check"
    fi
    for d in $DISKS; do
        DEV="/dev/$d"
        SMART_OUT=$(smartctl -H "$DEV" 2>/dev/null)
        if [ -z "$SMART_OUT" ]; then
            info "$DEV: SMART not accessible (USB bridge or virtual disk?)"
        elif echo "$SMART_OUT" | grep -Eqi "overall-health.*passed|health status: ok"; then
            pass "$DEV: SMART health OK"
        elif echo "$SMART_OUT" | grep -Eqi "overall-health|health status"; then
            fail "$DEV: SMART reports a problem — back up data"
            echo "$SMART_OUT" | grep -Ei "overall-health|health status" | sed 's/^/         /'
        else
            info "$DEV: SMART status line not found (unsupported device?)"
        fi
    done
fi

# ================================================================
echo ""
echo "-- 7. Orphaned kernel modules --"
# ================================================================
ORPHANS=""
for d in /usr/lib/modules/*/; do
    [ -d "$d" ] || continue
    pacman -Qo "$d" &>/dev/null || ORPHANS="$ORPHANS $(basename "$d")"
done
if [ -n "$ORPHANS" ]; then
    fail "Orphaned kernel module directories (no owning package) — booting these loses WiFi/audio/Bluetooth:$ORPHANS"
    if [ $FIX_MODE -eq 1 ]; then
        for o in $ORPHANS; do rm -rf "/usr/lib/modules/$o"; done
        grub-mkconfig -o /boot/grub/grub.cfg &>/dev/null
        fixed "Removed orphaned kernels and regenerated GRUB"
    else
        info "Fix: sudo rm -rf /usr/lib/modules/<orphan> && sudo grub-mkconfig -o /boot/grub/grub.cfg"
    fi
else
    pass "No orphaned kernel directories"
fi

# ================================================================
echo ""
echo "-- 8. Bluetooth --"
# ================================================================
if bluetoothctl show 2>/dev/null | grep -q Controller; then
    pass "Bluetooth controller present"
    if dmesg 2>/dev/null | grep -qi "Patch file not found"; then
        warn "Bluetooth firmware patch missing (known BCM4350C0 limitation — no known-good file yet)"
    fi
else
    warn "No Bluetooth controller visible"
fi

# ================================================================
echo ""
echo "-- 9. SelahBridgePro self-test --"
# ================================================================
# Installs + runs a small self-contained Windows audio app through Wine
# in a throwaway prefix. Added 2026-08-17 because selahbridgepro's
# wrapper can be present and "working" while its actual Wine runtime
# silently failed to install (a real pacstrap mirror failure that day
# left wine-staging/wine-gecko/etc. completely absent, with the
# installer still reporting success) -- checking for the wrapper script
# alone would have missed that entirely.
if [ -x /usr/local/bin/selah-bridgepro-selftest ]; then
    SBP_OUT=$(/usr/local/bin/selah-bridgepro-selftest 2>&1)
    SBP_RC=$?
    echo "$SBP_OUT" | sed 's/^/         /'
    if [ $SBP_RC -eq 0 ]; then
        pass "SelahBridgePro self-test: can install and run a Windows app with working audio"
    elif [ $SBP_RC -eq 1 ]; then
        warn "SelahBridgePro self-test passed with warnings (see above)"
    else
        fail "SelahBridgePro self-test FAILED (see above) — Wine runtime is likely missing or broken"
    fi
else
    info "selah-bridgepro-selftest not present on this system — skipping"
fi

# ================================================================
echo ""
echo "================================================================"
echo " SUMMARY: $PASS passed, $WARN warnings, $FAIL failures, $FIXED fixed"
echo "================================================================"
[[ $FIX_MODE -eq 1 && $FIXED -gt 0 ]] && echo " Reboot recommended to apply all repairs."
[[ $FIX_MODE -eq 0 && $FAIL -gt 0 ]] && echo " Re-run with --fix to repair automatically."
[ $FAIL -gt 0 ] && exit 2 || { [ $WARN -gt 0 ] && exit 1 || exit 0; }
