#!/usr/bin/env bash
# ============================================================
# selah-preflight-check — verify a LIVE or INSTALLED SelahOS
# system for the exact failure classes the bake-fixes handoff
# (2026-07-27) diagnosed on a real HP 230 G2: missing plymouth
# hook with quiet/splash still set, the Qt5 stack missing, and
# selahbridgepro/selah-apps unable to install.
#
# Extended same day (SELAH-50 addendum, morning) beyond GPU to the
# general "hardware present but not properly driven" pattern that's
# hit WiFi (SELAH-41), audio (CS8409), and Bluetooth firmware on this
# project already: full PCI enumeration, WiFi driver-bound check,
# CS8409 codec check, Broadcom Bluetooth firmware check. This is
# Part 1's first slice toward SELAH-50 (SelahSeedCore GPU/PCIe
# Detection & Safe First Boot) — SelahSeedCore itself is the intended
# longer-term home for this logic, not a permanent fork of it.
#
# 2026-07-27 night: this version had drifted from the literal file
# attached to the handoff (the rewrite above was more thorough in some
# ways but silently dropped two of the original checks) — restored the
# sddm-greeter ldd dependency check and kernel/initramfs/grub.cfg
# sanity check verbatim in spirit, plus added the Task 6 Discover/
# flatpak-remote check the handoff also required and which no version
# of this script had covered yet.
#
# This is deliberately NOT the same tool as tools/iso-preflight.sh
# (a build-host script that mounts a *built ISO's* squashfs before
# it's ever flashed). This one runs in-place against a live root —
# the live ISO session, a just-installed target via
# `arch-chroot /mnt selah-preflight-check`, or a running installed
# system (`selahpro preflight`) — so the same checks work at every
# stage without needing a mounted image.
#
# Usage: selah-preflight-check   (no args; always checks /)
# Exit codes: 0 = clean, 1 = warnings only, 2 = at least one FAIL
# ============================================================
set -uo pipefail

fail=0
warned=0
ok()   { printf '  OK   %s\n'   "$1"; }
bad()  { printf '  FAIL %s\n'   "$1"; fail=1; }
warn() { printf '  WARN %s\n'   "$1"; warned=1; }

echo "SelahOS pre-flight check — $(hostname 2>/dev/null || echo unknown)"
echo

# ── 1. Boot splash: plymouth hook vs quiet/splash consistency ─────────
# (SELAH-36 / tonight's HP box: quiet+splash with no plymouth hook =
# black screen with nothing drawn on it)
CMDLINE=""
[ -f /etc/default/grub ] && CMDLINE="$(grep -oP '^GRUB_CMDLINE_LINUX_DEFAULT="\K[^"]*' /etc/default/grub 2>/dev/null || true)"
HAS_QUIET_SPLASH=0
case " $CMDLINE " in *" quiet "*|*" splash "*) HAS_QUIET_SPLASH=1 ;; esac
HAS_PLYMOUTH_HOOK=0
if [ -f /etc/mkinitcpio.conf ] && grep -qs "plymouth" /etc/mkinitcpio.conf; then
    HAS_PLYMOUTH_HOOK=1
fi
PLYMOUTH_INSTALLED=0
pacman -Qq plymouth &>/dev/null && PLYMOUTH_INSTALLED=1

if [ "$HAS_QUIET_SPLASH" -eq 1 ] && [ "$HAS_PLYMOUTH_HOOK" -eq 0 ]; then
    bad "grub has quiet/splash but mkinitcpio.conf has no plymouth hook — black screen at boot"
elif [ "$HAS_PLYMOUTH_HOOK" -eq 1 ] && [ "$PLYMOUTH_INSTALLED" -eq 0 ]; then
    bad "mkinitcpio.conf has plymouth hook but plymouth package is not installed — mkinitcpio will fail"
else
    ok "boot splash config consistent (quiet/splash: $([ $HAS_QUIET_SPLASH = 1 ] && echo yes || echo no), plymouth hook: $([ $HAS_PLYMOUTH_HOOK = 1 ] && echo yes || echo no))"
fi

# ── 2. Qt5/QML stack (SDDM greeter + SelahOS theme, SELAH-36) ─────────
missing_qt5=()
for pkg in qt5-base qt5-declarative qt5-quickcontrols qt5-quickcontrols2 qt5-graphicaleffects qt5-svg; do
    pacman -Qq "$pkg" &>/dev/null || missing_qt5+=("$pkg")
done
if [ "${#missing_qt5[@]}" -eq 0 ]; then
    ok "Qt5/QML stack present (SDDM greeter can render)"
else
    bad "Qt5/QML stack incomplete — missing: ${missing_qt5[*]} (SDDM greets to a black screen)"
fi

# ── 2b. sddm-greeter dependency resolution ─────────────────────────────
# Belt and suspenders vs. check 2 above: the package list can be
# complete and ldd can still find an unresolved symbol/lib (e.g. after
# a partial upgrade), which is exactly what turns into a black screen
# even though every qt5-* package reports "installed".
if [ -f /usr/bin/sddm-greeter ]; then
    missing_libs=$(ldd /usr/bin/sddm-greeter 2>/dev/null | grep "not found")
    if [ -z "$missing_libs" ]; then
        ok "sddm-greeter: all dependencies resolved"
    else
        bad "sddm-greeter has missing dependencies: $(echo "$missing_libs" | tr '\n' ';')"
    fi
else
    bad "/usr/bin/sddm-greeter does not exist at all — sddm package likely incomplete"
fi

# ── 3. SelahOS product repo + selahbridgepro/selah-apps ───────────────
if [ -f /etc/pacman.conf ]; then
    if grep -qs '^\[selahos\]' /etc/pacman.conf; then
        ok "pacman.conf: [selahos] repo section active"
        if command -v pacman &>/dev/null && pacman -Si selah-apps &>/dev/null; then
            ok "selah-apps resolves via pacman"
        else
            warn "[selahos] repo section present but selah-apps did not resolve (repo unreachable or not synced — run pacman -Sy)"
        fi
    elif grep -qs '^#\[selahos\]' /etc/pacman.conf; then
        warn "pacman.conf: [selahos] repo present but commented out — repo.selahos.io is not live yet (packaging/README.md roadmap step 2). selah-apps/selahbridgepro cannot install via pacman until this is enabled."
    else
        bad "pacman.conf has no [selahos] repo section at all — selahbridgepro/selah-apps can never install via pacman on this machine"
    fi
else
    bad "/etc/pacman.conf missing entirely"
fi
# Loose-file install path (pre-packaging model) still counts as present
if [ -x /usr/local/bin/selahbridgepro ]; then
    ok "selahbridgepro present + executable (loose-file install)"
elif pacman -Qq selah-apps &>/dev/null; then
    ok "selah-apps package installed"
else
    warn "selahbridgepro/selah-apps not found on this system (may be expected pre-install)"
fi

# ── 4. exec bits on selah* tools + no junk files ───────────────────────
for f in /usr/local/bin/selah*; do
    [ -f "$f" ] || continue
    [ -x "$f" ] || bad "not executable: $f"
done
junk=$(find /usr/local/bin /usr/local/lib/selahos \
            -name '*.bak' -o -name '*.orig' -o -name '*~' \
            -o -name '__pycache__' -o -name '*.pyc' 2>/dev/null)
[ -z "$junk" ] && ok "no junk files in /usr/local" \
    || bad "junk files present: $(echo "$junk" | tr '\n' ' ')"

# ── 5. Broadcom Wi-Fi per-chip design (SELAH-41) ───────────────────────
if [ -f /etc/modprobe.d/selah-broadcom.conf ]; then
    grep -qs "blacklist brcmfmac" /etc/modprobe.d/selah-broadcom.conf \
        && ok "brcmfmac blacklisted (per-chip selection)" || bad "brcmfmac not blacklisted"
    if grep -hsvE '^\s*(#|$)' /etc/modules-load.d/*wifi*.conf /etc/modules-load.d/*broadcom*.conf 2>/dev/null | grep -q .; then
        bad "a Wi-Fi driver is force-loaded in modules-load.d (bypasses per-chip selection)"
    else
        ok "no Wi-Fi driver force-loaded"
    fi
fi

# ── 6. Hardware bus scan (SELAH-50 addendum, 2026-07-27 morning) ──────
# The pattern this project keeps hitting: hardware is present on the
# PCI/USB bus but not properly driven — WiFi (BCM4350: wrong driver),
# audio (CS8409: needs an out-of-tree driver), Bluetooth (BCM4350C0:
# needs specific firmware), GPU (last night: needs a fallback driver).
# This section generalizes past "GPU only" — GPU checks below are the
# original bake-fixes handoff Task 4 logic, unchanged. Tracked against
# SELAH-50 (SelahSeedCore GPU/PCIe Detection & Safe First Boot), not as
# a disconnected effort — this preflight script is Part 1's first
# slice; SelahSeedCore itself is the longer-term home for this logic.

# 6.0 Full PCI enumeration — visibility first, even without a specific
# check for a given device yet (SELAH-45's "say what's unknown, don't
# pretend everything's fine" principle).
if command -v lspci &>/dev/null; then
    echo "  --- lspci -nn (full device list) ---"
    lspci -nn 2>/dev/null | sed 's/^/  | /'
    echo "  ---"
else
    warn "lspci not available — PCI device scan skipped entirely (pciutils not installed)"
fi

# 6.1 GPU: NVIDIA generation check (bake-fixes handoff Task 4)
# First pass, simple name-pattern match — not the final architecture.
# Extend as SELAH-45's hardware-compat-db matures.
GPU_LINE=""
command -v lspci &>/dev/null && GPU_LINE="$(lspci -mm 2>/dev/null | grep -i 'VGA\|3D controller' | grep -i nvidia | head -1)"
if [ -n "$GPU_LINE" ]; then
    NOUVEAU_OK=0
    pacman -Qq xf86-video-nouveau &>/dev/null && NOUVEAU_OK=1
    if echo "$GPU_LINE" | grep -qiE 'GTX (10|9|7|6)[0-9]{2}|GT 10[0-9]{2}|Quadro [PMK][0-9]{3,4}'; then
        if [ "$NOUVEAU_OK" -eq 1 ]; then
            ok "NVIDIA GPU (Pascal-or-older class): nouveau DDX present — reduced-perf desktop expected, working"
        else
            bad "NVIDIA GPU (Pascal-or-older class) but xf86-video-nouveau not installed — likely no display driver at all"
        fi
    else
        warn "NVIDIA GPU detected, generation not in the Pascal-or-older pattern list — nouveau support may be poor or absent; consider the proprietary nvidia package"
    fi
fi

# 6.2 WiFi: Broadcom chip detected AND the correct driver actually
# bound (not just installed/configured — a driver can be present and
# still not be the one the kernel picked). Same chip->driver table as
# selah-wifi-driver; keep both in sync if that table changes.
if command -v lspci &>/dev/null; then
    for dev in /sys/bus/pci/devices/*; do
        [ -e "$dev/vendor" ] || continue
        read -r vendor < "$dev/vendor" 2>/dev/null
        [ "$vendor" = "0x14e4" ] || continue
        read -r class < "$dev/class" 2>/dev/null
        case "$class" in 0x0280*) ;; *) continue ;; esac
        read -r chip < "$dev/device" 2>/dev/null

        expected=""
        case "$chip" in
            0x43a3|0x43ba|0x43dc|0x4464|0x4488) expected="brcmfmac" ;;
            0x4331|0x43a0|0x43b1|0x4353|0x4357|0x432b|0x4727) expected="wl" ;;
            *) expected="" ;;
        esac

        bound="none"
        [ -e "$dev/driver" ] && bound="$(basename "$(readlink -f "$dev/driver")")"

        if [ -z "$expected" ]; then
            warn "unrecognized Broadcom Wi-Fi chip $chip — bound driver: $bound (no known-issue entry; extend selah-wifi-driver's table)"
        elif [ "$bound" = "$expected" ]; then
            ok "Broadcom Wi-Fi chip $chip: $expected bound (correct)"
        else
            bad "Broadcom Wi-Fi chip $chip: expected $expected but $bound is bound — Wi-Fi likely non-functional"
        fi
        break
    done
fi

# 6.3 Audio: CS8409 codec (MacBook Pro 14,1 and similar) needs the
# out-of-tree snd_hda_macbookpro driver — detected via codec presence,
# not machine identity, so this catches it regardless of DMI match.
CS8409_PRESENT=0
if ls /proc/asound/card*/codec#* &>/dev/null; then
    grep -lqi "CS8409" /proc/asound/card*/codec#* 2>/dev/null && CS8409_PRESENT=1
fi
if [ "$CS8409_PRESENT" -eq 1 ]; then
    # "installed" (pacman -Qi) is not proof the dkms build ever succeeded —
    # its pre_build script needs network to download kernel source to patch
    # against, and has silently failed to build for EVERY kernel before this
    # was moved into customize_airootfs.sh (which runs via arch-chroot and
    # gets a real resolv.conf, unlike pacstrap's own hook execution). Check
    # dkms status for an actual build, not just the package being present.
    BUILT=0
    command -v dkms &>/dev/null && dkms status 2>/dev/null | grep -q "^snd_hda_macbookpro" && BUILT=1
    LOADED=0
    lsmod 2>/dev/null | grep -q snd_hda_macbookpro && LOADED=1
    if [ "$BUILT" -eq 0 ]; then
        bad "CS8409 codec detected but snd_hda_macbookpro was never dkms-built for any kernel — audio will not work (check /var/lib/dkms/snd_hda_macbookpro/*/build/make.log)"
    elif [ "$LOADED" -eq 1 ]; then
        ok "CS8409 codec detected: snd_hda_macbookpro built and loaded"
    else
        warn "CS8409 codec detected: snd_hda_macbookpro built but not currently loaded — needs a full cold shutdown (not reboot) to take effect"
    fi
fi

# 6.4 Bluetooth: Broadcom BT combo chip detected, but is the firmware
# it needs actually present? A service can be "active" with no real
# firmware loaded, exactly like SDDM was "active" with no real Qt5
# stack — so check the firmware directory, not just the service.
if command -v lsusb &>/dev/null; then
    BT_LINE="$(lsusb 2>/dev/null | grep -iE 'bluetooth|BCM' | head -1)"
    if [ -n "$BT_LINE" ]; then
        if [ -d /usr/lib/firmware/brcm ] && [ -n "$(ls -A /usr/lib/firmware/brcm 2>/dev/null)" ]; then
            ok "Broadcom Bluetooth chip detected, /usr/lib/firmware/brcm populated"
        else
            bad "Broadcom Bluetooth chip detected but /usr/lib/firmware/brcm is missing or empty — chip will load with no working firmware"
        fi
        # Best-effort precise check: the kernel logs the exact .hcd it
        # wanted and whether the load succeeded. Only available when a
        # real kernel log exists for this boot (not inside an
        # arch-chroot at install time, where dmesg reflects the live
        # session instead) — skip quietly rather than false-flag.
        if command -v dmesg &>/dev/null && dmesg 2>/dev/null | grep -qi "brcm/.*\.hcd"; then
            if dmesg 2>/dev/null | grep -qi "Direct firmware load for brcm/.*\.hcd failed"; then
                bad "kernel log: Bluetooth firmware load failed (missing .hcd file for this exact chip)"
            else
                ok "kernel log: Bluetooth firmware loaded successfully"
            fi
        fi
    fi
fi

# ── 7. NetworkManager ───────────────────────────────────────────────────
if command -v systemctl &>/dev/null; then
    systemctl is-enabled NetworkManager &>/dev/null \
        && ok "NetworkManager enabled" || bad "NetworkManager not enabled"
fi

# ── 8. Kernel + initramfs + bootloader sanity ──────────────────────────
# Only meaningful on an installed target (arch-chroot /mnt or a booted
# installed system) — on the live ISO itself these paths don't apply the
# same way, so skip quietly there rather than false-flag.
if [ -d /boot ] && [ ! -d /run/archiso ]; then
    if compgen -G "/boot/initramfs-linux*.img" >/dev/null; then
        ok "initramfs image exists ($(ls /boot/initramfs-linux*.img | tr '\n' ' '))"
    else
        bad "no initramfs image found under /boot — check mkinitcpio output for errors"
    fi
    if [ -f /boot/grub/grub.cfg ]; then
        ok "grub.cfg exists"
    else
        bad "grub.cfg NOT found — GRUB was never generated (run: grub-mkconfig -o /boot/grub/grub.cfg)"
    fi
fi

# ── 9. Discover app backend (bake-fixes handoff Task 6) ────────────────
# flatpak alone isn't enough — Discover also needs a configured remote,
# which is the actual symptom Task 6 was filed against ("SelahOS is not
# configured for installing apps through Discover").
if pacman -Qq flatpak &>/dev/null; then
    if command -v flatpak &>/dev/null && flatpak remote-list 2>/dev/null | grep -q '^flathub'; then
        ok "flatpak installed + flathub remote configured"
    else
        bad "flatpak installed but flathub remote is not configured — Discover has no app backend"
    fi
else
    bad "flatpak not installed — Discover has no app backend at all"
fi

echo
if [ "$fail" -eq 1 ]; then
    echo "PRE-FLIGHT FAILED — do not consider this system ready"
    exit 2
elif [ "$warned" -eq 1 ]; then
    echo "PRE-FLIGHT PASSED WITH WARNINGS"
    exit 1
else
    echo "PRE-FLIGHT PASSED — clean"
    exit 0
fi
