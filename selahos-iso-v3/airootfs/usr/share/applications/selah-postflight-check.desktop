[Desktop Entry]
Type=Application
Name=SelahOS Health Check
GenericName=Hardware Diagnostics
Comment=Diagnose WiFi, sleep, DKMS, audio, disk and Bluetooth issues on this system
Exec=konsole -e sudo /usr/local/bin/selah-postflight-check
Icon=utilities-system-monitor
Terminal=false
